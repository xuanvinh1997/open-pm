# Server
OPENPM_PORT=8080
OPENPM_ENVIRONMENT=development
OPENPM_SITE_URL=http://localhost:3000

# Database
OPENPM_DATABASE_URL=postgres://openpm:openpm_secret@localhost:5432/openpm?sslmode=disable
OPENPM_DATABASE_MAX_OPEN_CONNS=25
OPENPM_DATABASE_MAX_IDLE_CONNS=5

# JWT
OPENPM_JWT_SECRET=change-this-to-a-long-random-secret-in-production
OPENPM_JWT_EXP=3600
OPENPM_JWT_REFRESH_EXP=604800
OPENPM_JWT_ISSUER=open-pm

# Redis
OPENPM_REDIS_URL=redis://localhost:6379/0

# SMTP (MailHog for development)
OPENPM_SMTP_HOST=localhost
OPENPM_SMTP_PORT=1025
OPENPM_SMTP_USER=
OPENPM_SMTP_PASS=
OPENPM_SMTP_FROM_NAME=Open-PM
OPENPM_SMTP_FROM_ADDR=noreply@open-pm.dev

# OAuth Providers
OPENPM_OAUTH_GITHUB_ENABLED=false
OPENPM_OAUTH_GITHUB_CLIENT_ID=
OPENPM_OAUTH_GITHUB_CLIENT_SECRET=
OPENPM_OAUTH_GITHUB_REDIRECT_URL=http://localhost:8080/auth/callback

OPENPM_OAUTH_GOOGLE_ENABLED=false
OPENPM_OAUTH_GOOGLE_CLIENT_ID=
OPENPM_OAUTH_GOOGLE_CLIENT_SECRET=
OPENPM_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# Storage (MinIO)
OPENPM_STORAGE_ENDPOINT=localhost:9000
OPENPM_STORAGE_ACCESS_KEY=minioadmin
OPENPM_STORAGE_SECRET_KEY=minioadmin
OPENPM_STORAGE_BUCKET=open-pm-assets
OPENPM_STORAGE_USE_SSL=false

# Rate Limiting
OPENPM_RATE_LIMIT_ENABLED=true
OPENPM_RATE_LIMIT_RPS=10

# Default Admin Account (development seed)
OPENPM_SEED_ADMIN_EMAIL=admin@open-pm.dev
OPENPM_SEED_ADMIN_PASSWORD=password123
OPENPM_SEED_ADMIN_FIRST_NAME=Admin
OPENPM_SEED_ADMIN_LAST_NAME=User
OPENPM_SEED_WORKSPACE_NAME=My Workspace
OPENPM_SEED_WORKSPACE_SLUG=my-workspace

# Frontend
VITE_API_URL=http://localhost:8080
